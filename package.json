{
	"name": "@jtmdias/frontend",
	"private": true,
	"workspaces": [
		"packages/*",
		"docs"
	],
	"engines": {
		"node": ">= 22",
		"npm": ">= 10"
	},
	"scripts": {
		"all:build": "lerna run build",
		"all:test": "lerna run test",
		"all:upgrade": "npx npm-check-updates",
		"docs:start": "cd ./docs && npm run start",
		"docs:build": "cd ./docs && npm run build",
		"docs:serve": "cd ./docs && npm run build && npm run serve",
		"reinstall": "rimraf node_modules && npm install",
		"project-graph": "npx nx graph",
		"create-changeset": "changeset",
		"version": "changeset version",
		"prerelease": "npm run all:build --if-present",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.12",
		"@types/node": "^22.13.0",
		"app-root-path": "^3.1.0",
		"cypress": "^13.17.0",
		"lerna": "^8.1.9",
		"react-router-dom": "5.3.4",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"allowScripts": {
		"cypress@13.17.0": true,
		"@parcel/watcher@2.6.0": true,
		"@swc/core@1.15.47": true,
		"core-js@3.50.0": true,
		"core-js-pure@3.50.0": true,
		"esbuild@0.25.12": true,
		"nx@20.8.4": true,
		"yarn@1.22.22": true,
		"unrs-resolver@1.12.2": true
	}
}
